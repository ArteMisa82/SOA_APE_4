# API DE VEHICULOS - PLANTILLA DE CONFIGURACION LOCAL (SIN SECRETOS)
# Copiar como application.properties y completar con valores locales o variables de entorno
server.port=${SERVER_PORT:8080}
server.address=127.0.0.1

# Base de datos MySQL
spring.datasource.url=jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3306}/${DB_NAME:venta_vehiculos}?useSSL=false&serverTimezone=UTC
spring.datasource.username=${DB_USER:root}
spring.datasource.password=${DB_PASSWORD:}

# Actuator: exponer unicamente salud HTTP (/actuator/health)
management.endpoints.web.exposure.include=health
management.endpoint.health.show-details=never

# Verificar la estructura sin modificar tablas
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.database-platform=org.hibernate.dialect.MariaDBDialect
spring.jpa.open-in-view=false
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# Autenticacion JWT y Cliente OAuth (definir valores reales localmente)
app.security.jwt-secret=${JWT_SECRET:CAMBIAR_CLAVE_JWT_MINIMO_32_CARACTERES}
app.security.access-token-minutes=30
app.security.refresh-token-minutes=1200
app.security.client-id=${OAUTH_CLIENT_ID:vehiculos-client}
app.security.client-secret=${OAUTH_CLIENT_SECRET:CAMBIAR_CLIENT_SECRET}

# Clave de integracion con FastAPI (minimo 32 caracteres)
app.security.service-key=${VENTAS_SERVICE_KEY:CAMBIAR_SERVICE_KEY}

# Servicio de notificaciones
servicios.notificaciones.url=${NOTIFICACIONES_URL:http://127.0.0.1:8081}
servicios.notificaciones.key=${NOTIFICACIONES_KEY:CAMBIAR_NOTIFICACIONES_KEY}
servicios.notificaciones.destinatario=notificaciones@uta.edu.ec

# Usuario inicial local (opcional, activar con perfil local)
# spring.profiles.active=local
app.bootstrap.user=admin-local
app.bootstrap.password=${BOOTSTRAP_PASSWORD:CAMBIAR_CLAVE_LOCAL}
app.bootstrap.role=ADMIN
