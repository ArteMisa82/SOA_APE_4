# ==============================================================================
# .gitignore - GUIA APE 04 (Exclusiones obligatorias de dependencias y secretos)
# ==============================================================================

# --- Secretos y configuraciones locales reales (solo se publican plantillas .example) ---
.env
.env.local
.env.*.local
**/src/main/resources/application.properties
**/src/main/resources/application-local.properties
**/src/main/resources/application-local.yml

# --- Java / Maven ---
target/
*.jar
*.war
*.ear
*.class
*.log
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# --- C# / .NET / Visual Studio ---
bin/
obj/
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
[Dd]ebug/
[Rr]elease/
x64/
x86/

# --- Python / FastAPI ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node.js / React / Vite / PWA ---
node_modules/
dist/
build/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Documentos locales (guías e informes) ---
Documentos/

# --- Documentos temporales / SO / IDEs ---
~$*.docx
~$*.xlsx
~$*.pptx
*.tmp
*.bak
.DS_Store
Thumbs.db
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# --- Archivos comprimidos y artefactos de entrega ---
*.zip
*.rar
*.7z
